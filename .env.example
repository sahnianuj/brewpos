# Copy this file to .env and fill in your Capella cluster details.
#
# Two unrelated sets of credentials live here - see app/config.py's module
# docstring for why:
#   - CB_* (Couchbase Server SDK): used ONLY by the one-time admin scripts
#     (scripts/setup_capella.py, seed_data.py, generate_orders.py,
#     simulate_traffic.py) to provision the bucket and load reference data.
#   - APP_SERVICES_* (Couchbase Lite for JavaScript, in the browser): what
#     the live app (Register/KDS/Pickup/Manager) actually connects to.

# --- Couchbase Server SDK (admin scripts only) ---
# Where to find these in Capella:
#  - CB_CONN_STRING: Cluster > Connect tab (starts with couchbases://)
#  - CB_USERNAME / CB_PASSWORD: Cluster > Settings > Database Access credentials
#    (create a DB user with read/write on the `brew` bucket)
#  - Make sure your current IP is in Cluster > Settings > Allowed IP Addresses,
#    or use "Allow Access from Anywhere" for a throwaway demo cluster.

CB_CONN_STRING=couchbases://cb.xxxxxxxxxxxx.cloud.couchbase.com
CB_USERNAME=demo-app
CB_PASSWORD=change-me
CB_BUCKET=brew

# --- Capella App Services (the live app's actual data path) ---
# See sync-gateway/app-services-setup.md for how to create these.
# Leave unset and the app still runs - each page shows an "App Services
# isn't configured" banner and stays on its local, unsynced database.
#
# App Services ties each App Endpoint to exactly one scope, so this demo's
# 4 scopes (catalog/people/operations/inventory) need 4 App Endpoints, all
# sharing the same host/port - only the path (endpoint name) differs. Name
# the 4 endpoints exactly "catalog", "people", "operations", "inventory"
# (see the setup doc) and set the base URL here WITHOUT a scope/database
# name on the end:
#   APP_SERVICES_BASE_URL=wss://<app-id>.apps.cloud.couchbase.com:4984
# (the app derives .../catalog, .../people, etc. itself - see
# app_services_url_for_scope() in app/config.py)
APP_SERVICES_BASE_URL=
APP_SERVICES_USERNAME=
APP_SERVICES_PASSWORD=

# --- App Services Admin API (scripts/assign_app_service_channels.py only) ---
# A separate credential/purpose from APP_SERVICES_USERNAME/PASSWORD above,
# even though - confirmed against a real Capella deployment - it currently
# happens to be the exact same App User. Kept as its own variable so the
# two concerns (what the browser syncs as vs. what grants channels via the
# Admin API) don't get conflated, and so this keeps working unchanged if
# you later split the browser credential into per-page ones (see the
# "Hardening later" note in sync-gateway/app-services-setup.md §3) without
# also having to rewire the admin script.
#
# Leave blank and assign_app_service_channels.py falls back to
# APP_SERVICES_USERNAME/PASSWORD automatically - only fill these in if you
# create a distinct admin credential.
APP_SERVICES_ADMIN_USERNAME=
APP_SERVICES_ADMIN_PASSWORD=

# Default store used by the POS/KDS/pickup/manager UI when none is specified.
DEFAULT_STORE_ID=10492

# How long to wait for the initial Capella connection before giving up.
# If connections are timing out (not an instant DNS/auth failure), Capella's
# free-tier clusters can take longer to wake up on a cold start - try
# bumping this to 30-60 before assuming something else is wrong.
CB_CONNECT_TIMEOUT_SECONDS=15
